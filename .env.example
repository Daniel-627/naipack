# Copy this file to .env.local and fill it in.

# --- Sanity ---------------------------------------------------------------
# Create a project at https://www.sanity.io/manage (free plan is enough),
# then paste its Project ID here. Leave empty to run on the built-in content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# --- Site -----------------------------------------------------------------
# The public address of the site (used for sitemap and social previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shows a thin "design preview" strip at the top while the site still has
# placeholder content. Set to false (or delete) before going live.
NEXT_PUBLIC_SHOW_PREVIEW_BANNER=true
